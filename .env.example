# ==============================================================================
# Triage Desk - Command Service Environment Variables (.env.example)
# ==============================================================================

# Server Configuration
SERVER_PORT=8081

# PostgreSQL & HikariCP Configuration
DATASOURCE_URL=jdbc:postgresql://localhost:5432/triage_command_db
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Redis Configuration (Distributed Locks & Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak / OAuth2 Resource Server
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/triage-desk

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200
